# Los comentarios van en su propia línea: systemd (EnvironmentFile) no admite comentarios al final.
TELEGRAM_BOT_TOKEN=
# Tu ID numérico de Telegram
ALLOWED_USER_ID=
# NO llamarla ANTHROPIC_API_KEY (ver CLAUDE.md)
ASSISTANT_ANTHROPIC_KEY=
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
# Opcional; si falta se usa Haiku
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
# rules+jev | rules+haiku
CLASSIFIER=rules+jev
# Zona IANA, p. ej. America/Mexico_City
TZ_NAME=
# P. ej. MXN, USD
CURRENCY_CODE=
DB_PATH=data/asistente.db
# Tope de gasto en IA; al superarlo se desactivan las rutas con LLM
MONTHLY_API_BUDGET_USD=8
# Equivale al flag --dry-run (multiplataforma)
DRY_RUN=0
LOG_LEVEL=INFO
# Cada cuánto revisa los avisos (5-60); un aviso llega 0 a N s tarde
TICK_SECONDS=30
